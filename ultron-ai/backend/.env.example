# ULTRON backend configuration. Copy to .env (never commit .env) or set these in your host's
# secret manager. Values below are PLACEHOLDERS ONLY.

# --- Provider (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
# Comma-separated model IDs your key can actually use. The first is the default.
GEMINI_MODELS=gemini-2.5-flash
# Override only for testing / a regional endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- App authentication (REQUIRED in production) ---
# Comma-separated long random strings. Enter one in the app: Menu -> Connectivity -> Access token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_TOKENS=replace-with-long-random-token
# Local development only: allow running without APP_TOKENS (never in production).
# ALLOW_NO_AUTH=true

# --- Server ---
PORT=8787
HOST=0.0.0.0
RATE_LIMIT_PER_MIN=30
MAX_BODY_BYTES=65536
MAX_MESSAGES=40
MAX_MESSAGE_CHARS=8000
UPSTREAM_TIMEOUT_MS=45000

# --- Identity (operator-controlled; the app cannot change it) ---
CREATOR_NAME=Fardeen
